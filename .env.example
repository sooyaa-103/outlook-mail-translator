# macOS Mail reads the school account already synchronized by the Mail app.
# Sign in to your Exchange account through Mail before running the script.
MAIL_SOURCE=apple_mail

# Required only for MAIL_SOURCE=graph; use your Entra app registration.
MS_CLIENT_ID=
MS_TENANT_ID=organizations
# Required for either source; select your own school mailbox explicitly.
SCHOOL_EMAIL=your_name@e.ntu.edu.sg

# Free offline English-to-Chinese translation; use azure for cloud translation.
TRANSLATION_PROVIDER=argos

# Required only for TRANSLATION_PROVIDER=azure.
TRANSLATOR_KEY=
# Leave blank for a global single-service resource; otherwise use its region.
TRANSLATOR_REGION=

# Inbox lookback window; processed messages are tracked to prevent duplicates.
LOOKBACK_DAYS=7
# Optional comma-separated exact sender domains; blank allows all senders.
SENDER_DOMAINS=
